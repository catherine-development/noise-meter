# Pi identity (matches the flight tracker Pi names)
PI_NAME=Catherine

# Port for the web app (5001 to avoid clashing with flight tracker on 5000)
PORT=5001

# Path to the SQLite database
NOISE_DB_PATH=/home/flightdata/noise-meter/noise.db

# Secret key for Flask session signing (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_string

# API key to protect the /import endpoint (set the same value in your .env on the Mac)
IMPORT_API_KEY=change_me_to_a_long_random_key

# Peer Pi noise app URL (for bidirectional sync every 15 minutes)
# Catherine: PEER_URL=https://noise-gladys.ives.org.uk
# Gladys:    PEER_URL=https://noise.ives.org.uk
PEER_URL=

# Password for the upload form. Leave empty and anyone who can reach /upload can
# import data; the app logs a warning at startup when it is empty.
UPLOAD_PASSWORD=

# Send the session cookie only over HTTPS. Default on, which is right for both
# Pis (served through Cloudflare). Set to 0 only for an instance reached over
# plain http on the LAN (http://192.168.x.x:5001) — a Secure cookie is never
# sent over http, so nobody can stay logged in there otherwise.
SESSION_COOKIE_SECURE=1

# Development escape hatch. The app refuses to start when the flight tracker's
# auth module cannot be imported, because every route would then be public.
# Set to 1 ONLY on a machine that is not reachable from the internet.
# ALLOW_UNAUTHENTICATED=1
